index 0000000..fac6940
--- /dev/null
+++ b/src/deluge/dsp/lxr/kick.cpp
@@ -0,0 +1,87 @@
+/* Copyright (C) 2012-2026 Erica Synths
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Modified for Delxr (2026). Ported from DrumVoice.c, Oscillator.c, Decay.c,
+ * SlopeEg2.c and snapEg.c. See PROVENANCE.md, LICENSE and NOTICE.md.
+ */
+#include "kick.h"
+#include <algorithm>
+#include <cmath>
+
+namespace deluge::dsp::lxr {
+namespace {
+constexpr int16_t sineTable[4097] = {
+#include "sine_table.inc"
+};
+constexpr float phaseScale = 4294967296.f / KickVoice::sampleRate;
+constexpr float controlRate = KickVoice::sampleRate / 64.f;
+
+// DecayEg_calcSlopeValue / slopeEg2_calcSlopeValue: LXR's rational
+// curvature of a linearly decaying envelope; the chosen slope is fixed here.
+float shape(float value, float slope) {
+    return (1.f + slope) * value / (1.f + slope * std::fabs(value));
+}
+
+int32_t sine(uint32_t phase) {
+    uint32_t index = phase >> 20;
+    uint32_t fraction = phase & 0xFFFFF;
+    int32_t a = sineTable[index];
+    // Same 12-bit table address and 20-bit linear interpolation as calcSine.
+    return a + static_cast<int32_t>((static_cast<int64_t>(sineTable[index + 1] - a) * fraction) >> 20);
+}
+float bounded(float x, float low, float high, float fallback) {
+    return std::isfinite(x) ? std::clamp(x, low, high) : fallback;
+}
+}
+
+void KickVoice::reset() { *this = KickVoice{}; }
+
+void KickVoice::trigger(float frequencyHz, float decaySeconds, float pitchSweep,
+                        float fmAmount, float velocity) {
+    reset();
+    frequency_ = bounded(frequencyHz, 8.f, 10000.f, 55.f);
+    float decay = bounded(decaySeconds, .005f, 8.f, .5f);
+    sweep_ = bounded(pitchSweep, 0.f, 8.f, 2.f);
+    fm_ = bounded(fmAmount, 0.f, 1.f, 0.f);
+    velocity_ = bounded(velocity, 0.f, 1.f, 1.f);
+    // LXR sine trigger phase (near the zero crossing of its -cosine table).
+    phase_ = modPhase_ = 0x3FFu << 20;
+    amplitudeTime_ = pitchTime_ = snapTime_ = 1.f;
+    amplitudeStep_ = 1.f / (controlRate * decay);
+    pitchStep_ = 1.f / (controlRate * .045f);
+    modIncrement_ = static_cast<uint32_t>(std::min(frequency_ * 1.5f, 18000.f) * phaseScale);
+    running_ = velocity_ > 0.f;
+}
+
+int32_t KickVoice::renderSample() {
+    if (!running_) { return 0; }
+    if (controlSample_ == 0) {
+        // Like the LXR async path, pitch and amp targets run once per 64 samples.
+        amplitudeTime_ = std::max(0.f, amplitudeTime_ - amplitudeStep_);
+        pitchTime_ = std::max(0.f, pitchTime_ - pitchStep_);
+        amplitudeTarget_ = shape(amplitudeTime_, -.85f);
+        float pitch = shape(pitchTime_, -.9f);
+        // SnapEg_calc: squared 24x pitch pulse, with a fixed decay setting.
+        float snap = 24.f * snapTime_ * snapTime_;
+        snapTime_ = std::max(0.f, snapTime_ - .2f);
+        float hz = frequency_ * (1.f + pitch * sweep_ + snap * .06f * sweep_);
+        increment_ = static_cast<uint32_t>(std::min(hz, 18000.f) * phaseScale);
+        fmEnvelope_ = fm_ * pitch;
+    }
+    controlSample_ = (controlSample_ + 1) & 63;
+    // LXR's USE_AMP_FILTER path: first-order smoothing at audio sample rate.
+    amplitude_ += .1f * (amplitudeTarget_ - amplitude_);
+    int32_t mod = sine(modPhase_);
+    modPhase_ += modIncrement_;
+    // calcFmSine's phase modulation scale. Signed multiplication then modulo
+    // uint32 conversion replaces upstream's negative float->unsigned cast.
+    int32_t modulated = static_cast<int32_t>(mod * fmEnvelope_);
+    uint32_t offset = static_cast<uint32_t>(static_cast<int64_t>(modulated) * 131072);
+    int32_t value = sine(phase_ + offset);
+    phase_ += increment_;
+    if (amplitudeTime_ == 0.f && amplitude_ < .00001f) {
+        running_ = false;
+        return 0;
+    }
+    return static_cast<int32_t>(value * (8192.f * amplitude_ * velocity_));
+}
+}
