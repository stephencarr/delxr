@@ -0,0 +1,31 @@
+/* Copyright (C) 2012-2026 Erica Synths
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Modified for Delxr (2026): independent 44.1 kHz drum-kernel state.
+ * Additional permission/terms: see NOTICE.md and LICENSE in this directory.
+ */
+#pragma once
+#include <cstdint>
+
+namespace deluge::dsp::lxr {
+// A deliberately restricted port of the LXR tonal drum kernel, not the full
+// LXR instrument. Each Deluge oscillator voice owns an independent instance.
+class KickVoice {
+public:
+    void reset();
+    void trigger(float frequencyHz, float decaySeconds, float pitchSweep,
+                 float fmAmount, float velocity = 1.f);
+    // Signed audio with peak <= 2^28; Deluge's existing amp/filter/pan follows.
+    int32_t renderSample();
+    bool active() const { return running_; }
+    static constexpr float sampleRate = 44100.f;
+private:
+    uint32_t phase_ = 0, modPhase_ = 0, increment_ = 0, modIncrement_ = 0;
+    float frequency_ = 55.f, amplitude_ = 0.f, amplitudeTarget_ = 0.f;
+    float amplitudeTime_ = 0.f, pitchTime_ = 0.f, snapTime_ = 0.f;
+    float amplitudeStep_ = 0.f, pitchStep_ = 0.f;
+    float sweep_ = 0.f, fm_ = 0.f, velocity_ = 0.f;
+    float fmEnvelope_ = 0.f;
+    uint8_t controlSample_ = 0;
+    bool running_ = false;
+};
+}
